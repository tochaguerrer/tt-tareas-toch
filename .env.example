# Copiar a .env.local. Nunca versionar valores reales.
# La URL y la clave publicable podrán usarse en el navegador; nunca una clave privilegiada.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Origen canónico; debe coincidir con la URL usada en el navegador y redirects.
APP_URL=http://127.0.0.1:3000
# Client ID y Client Secret de Google se configuran SOLO en Supabase Dashboard.
# Invitaciones de clientes. Solo servidor.
TETE_SUPABASE_SECRET_KEY=
